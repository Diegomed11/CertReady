# ---------------------------------------------------------------------------
# Variables de entorno del BFF de CertReady (web/).
# Copiar a `.env.local` para desarrollo. NO commitear `.env.local`.
# ---------------------------------------------------------------------------

# OIDC ---------------------------------------------------------------------
# En dev: emisor mock local (ver tools/oidc-mock). En prod: Cognito.
OIDC_ISSUER=http://localhost:9099
OIDC_CLIENT_ID=certready-web-dev
# OIDC_CLIENT_SECRET=...    # vacío para clientes públicos (PKCE)
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Sesión (cookie cifrada con iron-session) ---------------------------------
# Genera uno con: openssl rand -hex 32   (mínimo 32 bytes).
SESSION_PASSWORD=cambia-esto-por-32-bytes-aleatorios-cambia-esto-por-32-bytes
SESSION_COOKIE_NAME=certready_session

# Servicios backend (BFF llama a estas URLs) -------------------------------
CATALOG_BASE_URL=http://localhost:18090
USERS_BASE_URL=http://localhost:18091
ENROLLMENTS_BASE_URL=http://localhost:18092

# Servicios opcionales (incrementos del front). Si no se definen, las páginas
# que los usan muestran un error claro, pero el resto de la app funciona.
CONTENT_BASE_URL=http://localhost:18094
EXAMS_BASE_URL=http://localhost:18095
PROBLEMS_BASE_URL=http://localhost:18096
JUDGE_BASE_URL=http://localhost:18097
DSS_BASE_URL=http://localhost:18098
PROGRESS_BASE_URL=http://localhost:18093
